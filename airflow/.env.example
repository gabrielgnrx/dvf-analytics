# Copier vers airflow/.env (fichier ignoré par git)
AIRFLOW_UID=50000
GCP_PROJECT_ID=ton-projet-gcp
BQ_LOCATION=EU
BQ_RAW_DATASET=raw
# auto = années lues sur data.gouv à chaque exécution (ou liste : 2023,2024)
