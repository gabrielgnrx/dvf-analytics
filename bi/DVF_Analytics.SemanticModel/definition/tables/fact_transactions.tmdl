table fact_transactions
	lineageTag: 8cdef724-90f3-4a99-8e2e-57fcc0411d6f

	measure 'Nb ventes' = COUNTROWS ( fact_transactions )
		formatString: #,0
		displayFolder: Volumes
		lineageTag: db9117c7-f443-46c3-8df0-70b25d7df96a

	measure 'Volume ventes' = SUM ( fact_transactions[valeur_fonciere] )
		formatString: #,0
		displayFolder: Volumes
		lineageTag: ff9e0475-bf42-4176-b3fc-23d50e386fb5

	measure 'Nb ventes N-1' = CALCULATE ( [Nb ventes], SAMEPERIODLASTYEAR ( dim_temps[date] ) )
		formatString: #,0
		displayFolder: Volumes
		lineageTag: 01b6a30d-3126-48fc-ba29-ad5fa5d3f114

	measure 'Évolution volume' = DIVIDE ( [Nb ventes] - [Nb ventes N-1], [Nb ventes N-1] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Volumes
		lineageTag: f152f137-c671-4714-add3-e448186e29f3

	measure 'Prix m² médian' = CALCULATE ( MEDIAN ( fact_transactions[prix_m2] ), fact_transactions[est_prix_m2_fiable] = TRUE () )
		formatString: #,0
		displayFolder: Prix
		lineageTag: 069da2cb-ad94-472b-81e3-f5c958c1528f

	measure 'Prix m² moyen' = CALCULATE ( AVERAGE ( fact_transactions[prix_m2] ), fact_transactions[est_prix_m2_fiable] = TRUE () )
		formatString: #,0
		displayFolder: Prix
		lineageTag: dec1b249-e6e1-4a9a-8d4e-20c9eb8bcc5c

	measure 'Prix médian vente' = CALCULATE ( MEDIAN ( fact_transactions[valeur_fonciere] ), fact_transactions[est_vente_simple] = TRUE () )
		formatString: #,0
		displayFolder: Prix
		lineageTag: 265399b9-7dbc-460d-b6f4-cbe6d0e02f35

	measure 'Surface médiane' = CALCULATE ( MEDIAN ( fact_transactions[surface_habitable] ), fact_transactions[est_vente_simple] = TRUE () )
		formatString: #,0
		displayFolder: Prix
		lineageTag: 9da043cf-8ebf-4aea-9b47-ef1d46f6a269

	measure 'Prix m² médian N-1' = CALCULATE ( [Prix m² médian], SAMEPERIODLASTYEAR ( dim_temps[date] ) )
		formatString: #,0
		displayFolder: Prix
		lineageTag: c138803e-0419-4a80-b869-e8eb64a4372d

	measure 'Évolution prix m²' = DIVIDE ( [Prix m² médian] - [Prix m² médian N-1], [Prix m² médian N-1] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prix
		lineageTag: 496e763f-365f-47d8-a6bf-590048f5bab0

	measure 'Prix m² médian 12 mois glissants' = CALCULATE ( [Prix m² médian], DATESINPERIOD ( dim_temps[date], MAX ( dim_temps[date] ), -12, MONTH ) )
		formatString: #,0
		displayFolder: Prix
		lineageTag: 33132232-f167-4d9d-b5cb-df60b181926e

	measure 'Part ventes fiables' = DIVIDE ( CALCULATE ( [Nb ventes], fact_transactions[est_prix_m2_fiable] = TRUE () ), [Nb ventes] )
		formatString: 0.0%
		displayFolder: Qualité
		lineageTag: 5c162ab2-d962-4c74-9810-35993b67844d

	measure 'Part ventes simples' = DIVIDE ( CALCULATE ( [Nb ventes], fact_transactions[est_vente_simple] = TRUE () ), [Nb ventes] )
		formatString: 0.0%
		displayFolder: Qualité
		lineageTag: 830e3444-b35c-4636-b798-32c6e302793d

	measure 'Nb ventes écartées' = [Nb ventes] - CALCULATE ( [Nb ventes], fact_transactions[est_prix_m2_fiable] = TRUE () )
		formatString: #,0
		displayFolder: Qualité
		lineageTag: 657bfa42-80b3-413c-ba08-abcc2a2fd21c

	measure 'Nb ventes scorées' = COUNTROWS ( mart_ecarts_prix )
		formatString: #,0
		displayFolder: Modèle
		lineageTag: 623ec32d-c43d-4991-bd9a-58a7b019ee12

	measure 'Écart médian au modèle' = DIVIDE ( MEDIAN ( mart_ecarts_prix[ecart_pct] ), 100 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Modèle
		lineageTag: 425bbe28-aa63-402f-9af9-5864ae98420e

	measure 'Écart absolu médian au modèle' = DIVIDE ( MEDIANX ( mart_ecarts_prix, ABS ( mart_ecarts_prix[ecart_pct] ) ), 100 )
		formatString: 0.0%
		displayFolder: Modèle
		lineageTag: ca1b5461-8ec7-42bf-9f91-31d3fb77bc2f

	measure 'Part ventes sous le marché' = DIVIDE ( CALCULATE ( COUNTROWS ( mart_ecarts_prix ), mart_ecarts_prix[ecart_pct] <= -10 ), COUNTROWS ( mart_ecarts_prix ) )
		formatString: 0.0%
		displayFolder: Modèle
		lineageTag: f55bfeca-51e6-44f9-87f1-6af935cf85f0

	measure 'Prix m² prédit médian' = MEDIAN ( mart_ecarts_prix[prix_m2_predit] )
		formatString: #,0
		displayFolder: Modèle
		lineageTag: c42f6d64-1e34-42b2-b7cb-9440777ebf47

	measure 'Prix m² réel médian (scoré)' = MEDIAN ( mart_ecarts_prix[prix_m2] )
		formatString: #,0
		displayFolder: Modèle
		lineageTag: 8c6f336d-5372-478a-a1ce-d052800ec33c

	measure 'Évolution prix m² (12 mois)' = VAR fin = MAX ( fact_transactions[date_mutation] ) VAR cur = CALCULATE ( [Prix m² médian], DATESINPERIOD ( dim_temps[date], fin, -12, MONTH ) ) VAR prev = CALCULATE ( [Prix m² médian], DATESINPERIOD ( dim_temps[date], EDATE ( fin, -12 ), -12, MONTH ) ) RETURN DIVIDE ( cur - prev, prev )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Prix
		lineageTag: cbf45340-79af-4134-813d-3344f02c7858

